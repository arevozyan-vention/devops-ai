# Keycloak as a sibling ECS Fargate service on the existing cluster.
#
# Uses path-based routing on the existing ALB:  /auth/* → keycloak target group.
# Reuses the iam module's task exec / task roles (they already grant access
# to the application's Secrets Manager entries).
#
# Database: shares the existing RDS appdb. Keycloak creates its own tables
# (USER_ENTITY, REALM, CLIENT_*, ...) which don't collide with TypeORM's
# typical lowercase naming. A separate logical database would require a
# bootstrap step against RDS in private subnets — out of scope for now.
#
# Mode: start-dev. Suitable for dev environments. Production (--optimized
# build, full HTTPS, hostname strict) is a follow-up.

# Provider + version constraints come from versions.tf, generated by the
# root.hcl. Don't add a terraform { required_providers } block here — root's
# `generate "versions" { if_exists = "overwrite" }` would clash with it.

# ---- logs ------------------------------------------------------------------

resource "aws_cloudwatch_log_group" "keycloak" {
  name              = "/aws/ecs/${var.name}"
  retention_in_days = var.log_retention_days
  tags              = var.tags
}

# ---- security group --------------------------------------------------------

resource "aws_security_group" "keycloak" {
  name_prefix = "${var.name}-"
  description = "Keycloak ECS task SG"
  vpc_id      = var.vpc_id

  tags = merge(var.tags, { Name = "${var.name}-sg" })
}

resource "aws_security_group_rule" "ingress_from_alb" {
  type                     = "ingress"
  from_port                = 8080
  to_port                  = 8080
  protocol                 = "tcp"
  source_security_group_id = var.alb_security_group_id
  security_group_id        = aws_security_group.keycloak.id
  description              = "ALB to Keycloak on 8080"
}

resource "aws_security_group_rule" "egress_all" {
  type              = "egress"
  from_port         = 0
  to_port           = 0
  protocol          = "-1"
  cidr_blocks       = ["0.0.0.0/0"]
  security_group_id = aws_security_group.keycloak.id
  description       = "Egress: RDS, Docker Hub image pull, AWS APIs"
}

# ---- ALB target group ------------------------------------------------------

resource "aws_lb_target_group" "keycloak" {
  name_prefix = "kc-"
  port        = 8080
  protocol    = "HTTP"
  vpc_id      = var.vpc_id
  target_type = "ip"

  # In Keycloak 25 the /health endpoints (live/ready/started) are exposed on
  # the management interface (port 9000), NOT on the main HTTP port. So we
  # can't health-check via 8080 + /auth/health/ready.
  # /auth/realms/master is the next-best signal: once Keycloak finishes its
  # DB migration and initializes the master realm, GET on this path returns
  # a small JSON with status 200. Before that it returns 404, which keeps the
  # target unhealthy until Keycloak is genuinely ready to serve traffic.
  health_check {
    enabled             = true
    path                = "/auth/realms/master"
    matcher             = "200-399"
    interval            = 30
    timeout             = 10
    healthy_threshold   = 2
    unhealthy_threshold = 5
  }

  deregistration_delay = 30

  lifecycle {
    create_before_destroy = true
  }

  tags = merge(var.tags, { Name = "${var.name}-tg" })
}

# ---- ALB listener rules ----------------------------------------------------

# Two rules: one on the HTTP listener that redirects to HTTPS, one on the
# HTTPS listener that forwards to the keycloak target group.
#
# Reason for the redirect: Keycloak's master realm has sslRequired=external
# by default, so HTTP requests get rejected with "HTTPS required" anyway.
# Doing the redirect at the ALB level means the user types
# http://<alb>/auth/admin and is automatically bumped to https://<alb>/auth/admin
# instead of seeing a JSON error.
#
# The HTTPS forward rule is what attaches this target group to the load
# balancer (in the AWS API sense). Without it, AWS refuses to register the
# ECS service with the TG: "target group ... does not have an associated
# load balancer". So this rule must be created BEFORE the ECS service —
# enforced via depends_on below.

resource "aws_lb_listener_rule" "keycloak" {
  listener_arn = var.alb_listener_arn
  priority     = 100

  action {
    type = "redirect"

    redirect {
      protocol    = "HTTPS"
      port        = "443"
      status_code = "HTTP_301"
    }
  }

  condition {
    path_pattern {
      values = ["/auth", "/auth/*"]
    }
  }

  tags = var.tags
}

resource "aws_lb_listener_rule" "keycloak_https" {
  listener_arn = var.alb_https_listener_arn
  priority     = 100

  action {
    type             = "forward"
    target_group_arn = aws_lb_target_group.keycloak.arn
  }

  condition {
    path_pattern {
      values = ["/auth", "/auth/*"]
    }
  }

  tags = var.tags
}

# ---- ECS task definition ---------------------------------------------------

locals {
  container_name = "keycloak"
}

resource "aws_ecs_task_definition" "keycloak" {
  family                   = var.name
  network_mode             = "awsvpc"
  requires_compatibilities = ["FARGATE"]
  cpu                      = tostring(var.cpu)
  memory                   = tostring(var.memory)

  execution_role_arn = var.task_exec_role_arn
  task_role_arn      = var.task_role_arn

  container_definitions = jsonencode([
    {
      name      = local.container_name
      image     = var.image
      essential = true

      command = ["start-dev"]

      portMappings = [{
        containerPort = 8080
        protocol      = "tcp"
      }]

      environment = [
        # DB wiring — shared appdb on the existing RDS instance.
        { name = "KC_DB",          value = "postgres" },
        { name = "KC_DB_URL",      value = "jdbc:postgresql://${var.rds_address}:5432/${var.db_name}" },
        { name = "KC_DB_USERNAME", value = var.db_username },

        # HTTP behind an ALB doing TLS termination (or not, in dev): KC_PROXY=edge
        # tells Keycloak to trust X-Forwarded-* headers. Mounted under /auth.
        { name = "KC_HTTP_ENABLED",          value = "true" },
        { name = "KC_HTTP_RELATIVE_PATH",    value = "/auth" },
        { name = "KC_HOSTNAME_STRICT",       value = "false" },
        { name = "KC_HOSTNAME_STRICT_HTTPS", value = "false" },
        { name = "KC_PROXY",                 value = "edge" },
        { name = "KC_HEALTH_ENABLED",        value = "true" },

        # Bootstrap admin user. Override admin password via Secrets Manager (below).
        { name = "KEYCLOAK_ADMIN", value = "admin" },

        # JVM heap caps; leave headroom for the rest of the container.
        { name = "JAVA_OPTS_KC_HEAP", value = "-Xms256m -Xmx768m" },
      ]

      secrets = [
        { name = "KC_DB_PASSWORD",          valueFrom = var.kc_db_password_secret_arn },
        { name = "KEYCLOAK_ADMIN_PASSWORD", valueFrom = var.keycloak_admin_password_secret_arn },
      ]

      logConfiguration = {
        logDriver = "awslogs"
        options = {
          awslogs-group         = aws_cloudwatch_log_group.keycloak.name
          awslogs-region        = var.region
          awslogs-stream-prefix = "kc"
        }
      }
    }
  ])

  tags = var.tags
}

# ---- ECS service -----------------------------------------------------------

resource "aws_ecs_service" "keycloak" {
  name            = var.name
  cluster         = var.cluster_arn
  task_definition = aws_ecs_task_definition.keycloak.arn
  desired_count   = var.desired_count
  launch_type     = "FARGATE"

  enable_execute_command = true

  network_configuration {
    subnets          = var.subnet_ids
    security_groups  = [aws_security_group.keycloak.id]
    assign_public_ip = false
  }

  load_balancer {
    target_group_arn = aws_lb_target_group.keycloak.arn
    container_name   = local.container_name
    container_port   = 8080
  }

  # Keycloak start-dev takes ~75s for first run (DB migration of 134 changesets
  # against RDS), plus ALB needs 2 successful checks 30s apart. Total ≥ 135s
  # before a task can be declared healthy on a cold start. 300s gives headroom.
  health_check_grace_period_seconds = 300

  deployment_minimum_healthy_percent = 0
  deployment_maximum_percent         = 200

  # The HTTPS listener rule (forward to TG) is what makes AWS treat the
  # target group as "associated with a load balancer". Without it, ECS
  # CreateService rejects: "target group ... does not have an associated
  # load balancer". Both rules must exist before the service is created;
  # the HTTPS one matters most for TG attachment.
  depends_on = [
    aws_lb_listener_rule.keycloak,
    aws_lb_listener_rule.keycloak_https,
  ]

  tags = var.tags
}
