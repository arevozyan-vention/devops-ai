# Self-signed certificate + HTTPS listener on the existing ALB.
#
# This module is intentionally **service-agnostic**: it knows how to terminate
# TLS on the ALB but knows nothing about which services live behind it.
# Components that want HTTPS create their own `aws_lb_listener_rule` against
# `output.https_listener_arn`, attaching their own target groups.
#
# Browser will warn once about the self-signed CA (since it's not issued by a
# trusted authority). After click-through the connection is encrypted same as
# any HTTPS site. ALB terminates TLS, forwards over HTTP inside the VPC; the
# X-Forwarded-Proto: https header tells downstream services the original
# scheme (Keycloak's KC_PROXY=edge, NestJS's `app.set('trust proxy', 1)` etc.
# rely on this).
#
# When you need a real cert, replace this module with one that imports an ACM
# cert tied to your domain — the listener-rule mechanics stay the same.

# Provider + version constraints come from versions.tf, generated by root.hcl.

# ---- self-signed cert -----------------------------------------------------

resource "tls_private_key" "self_signed" {
  algorithm = "RSA"
  rsa_bits  = 2048
}

resource "tls_self_signed_cert" "self_signed" {
  private_key_pem = tls_private_key.self_signed.private_key_pem

  subject {
    common_name  = var.alb_dns_name
    organization = "devops-ai self-signed"
  }

  # 1 year, renewed when 30 days remain. Terraform regenerates the cert
  # transparently on apply once the early-renewal window opens.
  validity_period_hours = 8760
  early_renewal_hours   = 720

  allowed_uses = [
    "key_encipherment",
    "digital_signature",
    "server_auth",
  ]

  # Subject Alternative Names — at least the ALB DNS so the browser does
  # not complain about CN mismatch in addition to the trust warning.
  dns_names = [
    var.alb_dns_name,
    "localhost",
  ]
}

resource "aws_acm_certificate" "self_signed" {
  private_key      = tls_private_key.self_signed.private_key_pem
  certificate_body = tls_self_signed_cert.self_signed.cert_pem

  tags = merge(var.tags, { Name = "${var.alb_dns_name}-self-signed" })

  lifecycle {
    create_before_destroy = true
  }
}

# ---- HTTPS listener -------------------------------------------------------

# A bare HTTPS listener with no rules. The default action is a hard 404,
# pushing operators to be explicit: every path that should be served over
# HTTPS needs an `aws_lb_listener_rule` (forward) created by the consuming
# module against this listener's ARN. See `output.https_listener_arn`.
resource "aws_lb_listener" "https" {
  load_balancer_arn = var.alb_arn
  port              = 443
  protocol          = "HTTPS"
  ssl_policy        = "ELBSecurityPolicy-TLS13-1-2-2021-06"
  certificate_arn   = aws_acm_certificate.self_signed.arn

  default_action {
    type = "fixed-response"

    fixed_response {
      content_type = "text/plain"
      status_code  = "404"
      message_body = "Not found. No HTTPS route configured for this path. Add a listener rule (forward) attached to this HTTPS listener to expose a service."
    }
  }

  tags = var.tags
}
