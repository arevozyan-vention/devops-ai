terraform {
  source = "${dirname(find_in_parent_folders("inputs.yaml"))}/modules/postgres"
}

dependency "rg" {
  config_path = "../resource-group"
  mock_outputs = { name = "mock-rg" }
  mock_outputs_allowed_terraform_commands = ["validate", "init", "plan"]
}

dependency "vnet" {
  config_path = "../vnet"
  mock_outputs = {
    postgres_subnet_id            = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/mock/providers/Microsoft.Network/virtualNetworks/mock-vnet/subnets/mock-postgres-subnet"
    postgres_private_dns_zone_id  = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/mock/providers/Microsoft.Network/privateDnsZones/mock.private.postgres.database.azure.com"
  }
  mock_outputs_allowed_terraform_commands = ["validate", "init", "plan"]
}

dependency "secrets" {
  config_path = "../secrets"
  mock_outputs = {
    secret_values_by_key = { DATABASE_PASSWORD = "mock-password-do-not-use" }
  }
  mock_outputs_allowed_terraform_commands = ["validate", "init", "plan"]
}

locals {
  # Which Key Vault secret holds the DB master password. Read from the
  # project's inputs.yaml so any app can override without forking this file.
  # Default matches the skeleton's secret_names list. Apps with their own
  # naming convention set this in inputs.yaml — e.g.:
  #     db_password_secret_key: "ap-postgres-password"
  inputs_yaml            = yamldecode(file(find_in_parent_folders("inputs.yaml")))
  db_password_secret_key = try(local.inputs_yaml.db_password_secret_key, "DATABASE_PASSWORD")
}

inputs = {
  # Use the Key Vault value generated by our `secrets` module as the
  # Postgres administrator_password — single source of truth, the app's
  # KV secret and DB auth always agree by construction.
  admin_password = dependency.secrets.outputs.secret_values_by_key[local.db_password_secret_key]
}
