# _envcommon/rds.hcl — defaults for the RDS Postgres component.
# Per-env env.hcl overrides instance_class, storage size, multi_az, backup
# retention, deletion_protection.

terraform {
  source = "tfr:///terraform-aws-modules/rds/aws?version=6.10.0"
}

dependency "vpc" {
  config_path = "../vpc"
  mock_outputs = {
    vpc_id          = "vpc-xxxxxxxx"
    private_subnets = ["subnet-aaaa", "subnet-bbbb"]
    vpc_cidr_block  = "10.0.0.0/16"
  }
}

dependency "secrets" {
  config_path = "../secrets"
  mock_outputs = {
    secret_arns_by_key   = { DATABASE_PASSWORD = "arn:aws:secretsmanager:us-east-1:000000000000:secret:mock" }
    secret_values_by_key = { DATABASE_PASSWORD = "mock-password-do-not-use" }
  }
}

dependency "rds_sg" {
  config_path = "../rds-sg"
  mock_outputs = {
    security_group_id = "sg-xxxxxxxx"
  }
}

locals {
  # Which Secrets Manager key holds the DB master password. Read from the
  # project's inputs.yaml so any app can override without forking this
  # file. Default matches the skeleton's secret_keys list.
  inputs_yaml            = yamldecode(file(find_in_parent_folders("inputs.yaml")))
  db_password_secret_key = try(local.inputs_yaml.db_password_secret_key, "DATABASE_PASSWORD")
}

inputs = {
  identifier = "" # filled in per-env via env.hcl

  engine               = "postgres"
  family               = "postgres16"
  major_engine_version = "16"
  port                 = 5432

  # Use the Secrets Manager value generated by our `secrets` module as the
  # RDS master password — one source of truth, the app's
  # `<DB_PASSWORD_KEY>` secret and RDS auth always agree by construction.
  # Previously we used `manage_master_user_password = true`, but that has
  # AWS create a SEPARATE managed secret, leaving our app-side secret as
  # an orphan with a random value the DB never accepts.
  manage_master_user_password = false
  password                    = dependency.secrets.outputs.secret_values_by_key[local.db_password_secret_key]

  storage_type      = "gp3"
  storage_encrypted = true

  iam_database_authentication_enabled = false

  vpc_security_group_ids = [] # populated via env.hcl with the rds SG
  subnet_ids             = dependency.vpc.outputs.private_subnets

  create_db_subnet_group = true

  performance_insights_enabled    = false
  monitoring_interval             = 0
  enabled_cloudwatch_logs_exports = ["postgresql"]

  copy_tags_to_snapshot = true
  skip_final_snapshot   = true # overridden to false in prod
  apply_immediately     = false
}
